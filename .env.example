# Nimbus Drive — environment template.
# Copy to `.env` and fill in. Never commit the result; `.env` is gitignored.
#
# Deploying to Render? You do not need this file — `render.yaml` declares every
# variable and Render prompts for the secrets. This is for local development and
# for self-hosting somewhere else. See docs/SETUP.md.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development            # development | test | production
DEBUG=false
# Comma-separated. Narrow this in production — "*" with credentials allowed is
# only tolerable on a machine you control.
CORS_ORIGINS=*

# The port the app binds. Render injects this automatically (10000); leave it
# unset there.
# PORT=8000

# ---------------------------------------------------------------------------
# Database (docker compose fills these in for the api service)
#
# `postgresql://` and `postgres://` are both accepted and rewritten to the async
# driver on load, so a managed provider's connection string can be pasted
# verbatim. A `?sslmode=` parameter is translated too — asyncpg rejects it.
#
# SUPABASE: use the **Session pooler** string (port 5432) from
#   Project Settings → Database → Connection string → Session pooler
#
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-<region>.pooler.supabase.com:5432/postgres
#
# Avoid the direct connection (db.<ref>.supabase.co) — IPv6-only without the
# paid IPv4 add-on. The transaction pooler (port 6543) also works: the app
# detects it and turns off prepared statements automatically, which Supavisor
# cannot support in that mode. Session mode is faster, so prefer it.
# ---------------------------------------------------------------------------
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nimbus
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nimbus:change-me@localhost:5432/nimbus

# Optional. Enables access-token revocation on logout and rate limits that hold
# across replicas. The API runs without it.
# REDIS_URL=redis://localhost:6379/0

API_PORT=8000

# ---------------------------------------------------------------------------
# JWT signing (RS256) — REQUIRED in production
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
#
# Paste the PEMs as single lines with literal \n escapes, or use a multi-line
# value if your process manager supports it.
# ---------------------------------------------------------------------------
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Secret encryption — REQUIRED in production
#
# Encrypts stored Telegram bot tokens at rest (AES-256-GCM).
#   openssl rand -base64 32
#
# Rotating this makes every stored bot token unreadable; users must re-bind
# their channel. There is no key-rotation migration yet.
# ---------------------------------------------------------------------------
# SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Telegram
#
# API_ID / API_HASH come from https://my.telegram.org and belong to *you*, the
# operator — not to your users. They are only needed for MTProto, i.e. files
# over 20 MB and video streaming. Without them the API still serves everything
# up to 20 MB.
# ---------------------------------------------------------------------------
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Large-file staging
#
# Uploads over 20 MB are written to one temp file, chunked, forwarded to
# Telegram and deleted. Nothing here needs to persist across a restart, so an
# ephemeral filesystem (as on Render) is exactly right — do not attach a disk.
#
# Size these to the disk you actually have: N concurrent uploads of a 2 GB file
# want 2N GB of scratch space.
# ---------------------------------------------------------------------------
TEMP_DIR=/tmp/nimbus
MAX_CONCURRENT_LARGE_UPLOADS=3
# Refuse new uploads once staged files exceed this many bytes (default 10 GiB).
# MAX_TEMP_DIR_BYTES=10737418240

# ---------------------------------------------------------------------------
# OAuth (optional)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
TRASH_RETENTION_DAYS=30
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Rate limits, "<count>/<seconds>"
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_SHARE_PUBLIC=60/60
